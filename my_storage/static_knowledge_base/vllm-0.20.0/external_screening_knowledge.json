      "fact_id": "EXT001-concurrent-partial-prefill-unsupported",
      "parameters": [
        "max_num_partial_prefills",
        "max_long_partial_prefills"
      ],
      "relation": "supported_domain",
      "question_types": ["supported_domain"],
      "statement": "In vLLM 0.20.0, feature validation raises an unsupported-feature error whenever max_num_partial_prefills or max_long_partial_prefills differs from the SchedulerConfig default; concurrent partial prefill therefore has no non-default supported value.",
      "applicability_when": [
        "vllm_version == 0.20.0"
      ],
      "source_ids": [
        "vllm-arg-utils-0.20.0"
      ],
      "source_locator": "_check_feature_supported, lines around 2153-2159",
      "confidence": 1.0
