        "execution_scope",
        "materialization"
      ],
      "statement": "In vLLM 0.20.0, LoadConfig is the configuration for loading model weights, and its compute_hash intentionally contains no factors because the config does not affect the model computation graph. load_format selects the weight loader or checkpoint representation during model loading.",
      "applicability_when": [
        "vllm_version == 0.20.0"
      ],
      "source_ids": [
        "vllm-load-config-source-0.20.0"
      ],
      "source_locator": "LoadConfig declaration and compute_hash, lines 23-26 and 105-120",
