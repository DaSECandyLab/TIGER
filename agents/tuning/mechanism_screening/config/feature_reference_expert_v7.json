        "theoretical_global_in_flight_upper": 1,
        "generation_tokens_per_request": 1
      },
      "note": "建模层归并为 none/on，关注容量及多步 decode 的条件性机会；batch 大小因收益路径方向冲突不纳入整体均分。on 的实际量化方法沿用合法配置映射。",
      "choices": [
        "none",
        "on"
      ],
      "positive_option": "on",
      "negative_option": "none"
    },
    "dtype": {
