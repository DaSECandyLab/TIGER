    },
    "kv_cache_dtype": {
      "feature_directions": {
        "prompt_tokens_per_request": 1,
        "data_prompt_len_p50": 1,
        "data_prompt_len_p95": 1,
        "output_len_p50": 1,
        "output_len_p95": 1,
        "actual_global_in_flight_peak": 1,
        "actual_batch_size_mean": 1,
        "kv_cache_usage_mean": 1,
        "kv_cache_usage_p90": 1
      },
      "note": "信号建模层将 KV 位宽归并为 16bit/8bit；正分支持 8bit，负分支持 16bit。具体 KV 格式继续由合法配置映射。",
      "choices": [
        "16bit",
        "8bit"
      ],
      "positive_option": "8bit",
      "negative_option": "16bit"
    },
    "cacheblend_mode": {
