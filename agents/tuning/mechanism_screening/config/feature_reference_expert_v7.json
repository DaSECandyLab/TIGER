  "scoring": {
    "feature_formula": "direction * (current_value - reference_mean) / reference_mean",
    "mechanism_formula": "arithmetic_mean(valid_signed_deviations)",
    "missing_feature_policy": "exclude_from_numerator_and_denominator; report coverage",
    "empty_feature_policy": "final score=0 for mechanisms without valid directional signals; raw_score=null",
    "weighting": "equal_per_feature; no clipping or thresholds",
    "interpretation": "专家方向先验的相对信号均分，不是实测加速比或概率；条件性方向仍受原设计中成立条件限制。",
    "imputation_policy": "no cross-mechanism imputation; missing mechanism signal uses zero"
  },
  "mechanisms": {
    "enable_prefix_caching": {
      "feature_directions": {
        "prefix_reuse_ratio": 1,
        "prefix_cache_hit_rate": 1,
